{
  "name": "ms_dcat_ap Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,Z",
  "mounts": [
    "source=${localEnv:HOME}/.junie,target=/home/vscode/.junie,type=bind,Z"
  ],
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000"
  ],
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "MkDocs Documentation Server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "uv sync --group dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "skellock.just"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${localWorkspaceFolder}/.venv/bin/python",
        "editor.formatOnSave": true
      }
    }
  }
}
