{
  "name": "ms_dcat_ap Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "${localWorkspaceFolder}",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,Z",
  "mounts": [
    "source=codex-devcontainer,target=/home/vscode/.codex,type=volume",
    "source=copilot-devcontainer,target=/home/vscode/.copilot,type=volume",
    "source=copilot-auth-devcontainer,target=/home/vscode/.config/github-copilot,type=volume"
  ],
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000"
  ],
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "MkDocs Documentation Server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "uv sync --group dev"
}
